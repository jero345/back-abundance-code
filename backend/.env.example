PORT=5000
NODE_ENV=development

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Supabase
# Get these from: Supabase Dashboard â†’ Project Settings â†’ API
#   - URL                    â†’ SUPABASE_URL
#   - anon / public key      â†’ SUPABASE_ANON_KEY        (safe in frontend too)
#   - service_role secret    â†’ SUPABASE_SERVICE_ROLE_KEY (server-only, never ship!)
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PUBLIC.anon.key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SECRET.service.role.key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App
FRONTEND_URL=http://localhost:5173
# Orígenes extra permitidos por CORS, separados por comas. Necesario en
# producción si la web se sirve además desde otro dominio (p. ej. con y sin www).
# En desarrollo no hace falta: localhost, 127.0.0.1 y *.devtunnels.ms ya se
# aceptan en cualquier puerto.
CORS_EXTRA_ORIGINS=
APP_URL=http://localhost:5000

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@abundacecode.com

# Precio (en centavos). Deben coincidir con frontend/src/config.js,
# que es lo que ve el usuario en la web.
#
# Modelo: $49 hoy (cubre 30 dias) y despues $14.99/mes.
# En Stripe = suscripcion mensual con 30 dias de trial + cargo unico inicial.
#   $49.00  = 4900
#   $14.99  = 1499
PRICE_INITIAL_CENTS=4900
PRICE_MONTHLY_CENTS=1499
INCLUDED_DAYS=30

# ---------------------------------------------------------------------------
# App (Lovable) — a donde se manda al usuario despues de pagar
# APP_PUBLIC_URL es tambien el success_url de Stripe, con el token dentro.
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=https://astro-ai-decoder.lovable.app
APP_ACTIVATE_PATH=/activar

# Secreto compartido entre este backend y la app.
# La app lo manda en Authorization: Bearer <secreto> para llamar a
# /api/access/redeem y /api/access/status. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUNCA debe acabar en el navegador: solo servidor a servidor.
APP_SHARED_SECRET=genera_un_secreto_largo_aqui

# WooCommerce REST API v3 (optional â€” sync products via webhook)
WC_URL=https://shop.abundacecode.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=
WC_CRYSTAL_CODE_ID=0
WC_CRYSTAL_CODE_PREMIUM_ID=0

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
